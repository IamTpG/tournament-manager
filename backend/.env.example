# Sao chép file này thành `.env` rồi điền giá trị:
#
#   cp .env.example .env
#
# `.env` đã nằm trong .gitignore — không commit file đó.

# Chuỗi kết nối MongoDB.
# Khớp với service `mongo` trong docker-compose.yml ở thư mục gốc.
DATABASE_URL=mongodb://localhost:27017/tournax

# Khoá ký JWT. Đặt bất kỳ chuỗi ngẫu nhiên dài nào cho môi trường phát triển.
# Sinh nhanh một khoá:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai
